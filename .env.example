# MES configuration — copy to .env (repository root) and edit. `.env` is git-ignored: keep your keys there.
# Precedence: real environment variables > .env.<hostname> (one computer only) > .env.
# Relative paths below are relative to the repository root, whichever folder MES is started from.

# ---------------------------------------------------------------- language model
# openai   = OpenAI models with your own API key (default)
# lmstudio = a local model served by LM Studio (OpenAI-compatible server; nothing leaves the computer but the searches)
MES_LLM_PROVIDER=openai

# OpenAI (MES_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
MES_OPENAI_MODEL=gpt-5.4-nano
# Optional: another OpenAI-compatible endpoint for this backend
# OPENAI_BASE_URL=

# LM Studio (MES_LLM_PROVIDER=lmstudio): `lms server start`, then load the model with a large context:
#   lms load google/gemma-4-e4b -c 32768 --parallel 4 -y
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b

# ---------------------------------------------------------------- evidence sources
# Folder of the local stores (default: data/ in the repository); see docs/DATA.md
# MES_DATA_DIR=
# MES_IBKH_DIR=
# MES_PDF_DIR=
# MIMIC-IV (credentialed access): the v2.2 CSV release and the store built from it by scripts/build_mimic_db.py
# MES_MIMIC_SOURCE=data/mimic-iv-2.2
# MES_MIMIC_DIR=data/mimic
# Optional: NCBI API key (10 instead of 3 requests/s) and contact e-mail (NCBI etiquette;
# also enables the Unpaywall open-access PDF fallback)
MES_NCBI_API_KEY=
MES_CONTACT_EMAIL=

# ---------------------------------------------------------------- retrieval and synthesis
# Sentence encoder for ranking and KG linking. If changed, rebuild the KG node embeddings.
MES_ENCODER=sentence-transformers/all-MiniLM-L6-v2
# Characters of evidence sent to the synthesis call (Fast uses 0.75x, Balanced 1.3x, Deep 1.7x).
# 24000 suits a 32K-context local model; large cloud models can take 60000+.
MES_CONTEXT_BUDGET=24000
# Lifetime of cached API responses and answers (hours)
MES_HTTP_CACHE_TTL_HOURS=72
# 1 = verify HTTPS with the OS trust store (needed behind TLS-inspecting proxies); 0 = certifi
MES_SYSTEM_CERTS=1
# Answer, HTTP and full-text caches and the saved conversations (default: .cache in the repository)
# MES_CACHE_DIR=
# The real-world data analyst that writes and runs its own analysis code: auto | on | off
# MES_RWD_ANALYST=auto
# Editing an answer's protocol and re-running it (🔒 switches, locked by default): on | no_code | off
# MES_PROTOCOL_EDIT=on
